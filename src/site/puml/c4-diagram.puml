' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.

@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
title Ghostwriter - C4 Component Diagram

Person(user, "User", "Configures and runs Ghostwriter in Guidance or Act mode.")
System_Ext(projectFiles, "Project File System", "Source, documentation, configuration, Act definitions, and generated files.")
System_Ext(remoteResources, "Remote Resources", "HTTP/HTTPS prompt content and remotely hosted Act definitions.")
System_Ext(modelProvider, "GenAI Provider", "External model service that processes prompts and requests registered tool calls.")

Container_Boundary(ghostwriter, "Ghostwriter (Java application)") {
  Component(cli, "CLI Entry Point", "Ghostwriter", "Parses command-line options, loads configuration, selects Guidance or Act mode, and starts scans.")
  Component(fileProcessor, "Project Scan Core", "AbstractFileProcessor", "Uses the Project Layout library to discover and traverse files and modules, filter paths, and delegate processing.")
  Component(aiProcessor, "AI Processing Core", "AIFileProcessor", "Builds project context, resolves includes and layered settings, registers tools, and runs prompts through the provider runtime.")
  Component(guidanceProcessor, "Guidance Mode", "GuidanceProcessor", "Uses extension-specific reviewers to extract @guidance instructions and sends matching files for processing.")
  Component(actProcessor, "Act Mode", "ActProcessor", "Loads and merges TOML Acts, applies properties, and executes prompts against the project.")
  Component(episodes, "Episode Execution", "Episodes", "Orders and runs Act episodes; supports selection, repeat, and jump behavior.")

  Component(reviewerPlugins, "Reviewer Plugins", "Reviewer implementations", "Service-loaded reviewers extract guidance from Java, Markdown, PlantUML, HTML, Python, TypeScript, and text files.")

  Component(fileTools, "File Tools", "FileFunctionTools", "Reads, writes, patches, and lists project files and directories.")
  Component(commandTools, "Command Tools", "CommandFunctionTools + CommandSecurityChecker", "Runs security-checked project commands and exposes command logs.")
  Component(controlTools, "Execution Control", "CommandSpecFunctionTools", "Signals task completion or controlled process termination.")
  Component(webTools, "Web Tools", "WebFunctionTools", "Fetches web content and calls REST APIs.")
  Component(actTools, "Act Tools", "ActFunctionTools", "Inspects Act definitions, runs Acts synchronously or asynchronously, and supplies prompts and persisted results; excluded from Guidance mode.")
  Component(episodeTools, "Episode Control Tools", "ActSpecFunctionTools", "Signals repeat and jump requests through exceptions; available only in Act mode.")
  Component(guidanceTools, "Guidance Tools", "GuidanceFunctionTools", "Discovers and processes guidance-tagged files through tool calls.")
  Component(contextTools, "Project Context Tools", "ProjectContextFunctionTools", "Stores and retrieves variables scoped to a project directory.")
}

Rel(user, cli, "Invokes")
Rel(cli, projectFiles, "Loads configuration properties")
Rel(cli, guidanceProcessor, "Selects default Guidance mode")
Rel(cli, actProcessor, "Selects Act mode")
Rel(cli, fileProcessor, "Configures scan paths and options")

Rel(aiProcessor, fileProcessor, "Inherits scan lifecycle")
Rel(guidanceProcessor, aiProcessor, "Extends and processes with")
Rel(actProcessor, aiProcessor, "Extends and executes prompts with")
Rel(actProcessor, episodes, "Configures and executes")
Rel(episodes, actProcessor, "Executes episode callbacks and records results")
Rel(guidanceProcessor, reviewerPlugins, "Dispatches by file extension")
Rel(reviewerPlugins, projectFiles, "Reads guidance-bearing files")

Rel(fileProcessor, projectFiles, "Traverses and filters")
Rel(aiProcessor, projectFiles, "Resolves local includes")
Rel(aiProcessor, remoteResources, "Resolves remote includes", "HTTP/HTTPS")
Rel(actProcessor, projectFiles, "Loads local Act definitions")
Rel(actProcessor, remoteResources, "Loads remote Act definitions", "HTTP/HTTPS")
Rel(aiProcessor, modelProvider, "Sends prompts; receives responses and tool requests via provider runtime")
Rel(actProcessor, modelProvider, "Requests automatic episode tool selection")

Rel(aiProcessor, fileTools, "Registers and exposes via provider runtime")
Rel(aiProcessor, commandTools, "Registers and exposes via provider runtime")
Rel(aiProcessor, controlTools, "Registers and exposes via provider runtime")
Rel(aiProcessor, webTools, "Registers and exposes via provider runtime")
Rel(aiProcessor, actTools, "Registers when supported and enabled")
Rel(aiProcessor, episodeTools, "Registers for Act mode when enabled")
Rel(aiProcessor, guidanceTools, "Registers when supported and enabled")
Rel(aiProcessor, contextTools, "Registers and populates project context")

Rel(fileTools, projectFiles, "Reads and writes")
Rel(commandTools, projectFiles, "Runs commands in")
Rel(webTools, remoteResources, "Fetches and calls", "HTTP/HTTPS/REST")
Rel(webTools, projectFiles, "Reads file resources")
Rel(actTools, actProcessor, "Loads or starts Acts")
Rel(actTools, projectFiles, "Loads definitions and persists asynchronous results")
Rel(episodeTools, episodes, "Signals repeat or jump")
Rel(guidanceTools, guidanceProcessor, "Discovers and processes files")

SHOW_LEGEND()
@enduml
