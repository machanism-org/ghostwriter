' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.

@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()

 title Ghostwriter - C4 Component Diagram

Person(user, "User", "Runs Ghostwriter in Guidance or Act mode.")
System_Ext(projectFiles, "Project File System", "Source, test, documentation, configuration, Act, and generated files.")
System_Ext(remoteResources, "Remote Resources", "HTTP/HTTPS content and remotely hosted Act or prompt definitions.")
System_Ext(projectLayout, "Project Layout Library", "Discovers project structure, modules, and project-relative paths.")
System_Ext(processProvider, "GenAI Provider", "External model service used for prompts and tool-assisted processing.")

System_Boundary(ghostwriter, "Ghostwriter") {
  Component(cli, "CLI Entry Point", "Ghostwriter", "Parses command-line options, loads configuration, selects Guidance or Act mode, and starts processing.")
  Component(fileProcessor, "File Processing Core", "AbstractFileProcessor", "Traverses projects and modules, applies path matching and exclusions, and invokes file or folder processing.")
  Component(aiProcessor, "AI Processing", "AIFileProcessor", "Builds prompt context, resolves includes and substitutions, configures tools, invokes the provider, and handles interactive processing.")
  Component(guidanceProcessor, "Guidance Processing", "GuidanceProcessor", "Extracts @guidance directives, selects reviewers by extension, and processes matching files.")
  Component(actProcessor, "Act Processing", "ActProcessor", "Loads TOML Acts, merges inherited definitions, applies properties, and executes selected prompts.")
  Component(episodes, "Episode Execution", "Episodes", "Selects, orders, repeats, and advances Act episodes, including explicit selection and stop behavior.")

  Component(javaReviewer, "Java Reviewer", "JavaReviewer", "Extracts guidance from Java source files.")
  Component(markdownReviewer, "Markdown Reviewer", "MarkdownReviewer", "Extracts guidance from Markdown files.")
  Component(pumlReviewer, "PlantUML Reviewer", "PumlReviewer", "Extracts guidance from PlantUML files.")
  Component(otherReviewers, "Other Reviewers", "HtmlReviewer / PythonReviewer / TypeScriptReviewer / TextReviewer", "Extract guidance from the remaining supported file formats.")

  Component(fileTools, "File Tools", "FileFunctionTools", "Reads, writes, patches, and lists project files and directories.")
  Component(commandTools, "Command Tools", "CommandFunctionTools + CommandSecurityChecker", "Runs security-checked project commands and exposes command logs.")
  Component(controlTools, "Execution Control", "CommandSpecFunctionTools", "Signals task completion or process termination through controlled workflow exceptions.")
  Component(webTools, "Web Tools", "WebFunctionTools", "Fetches web content, reads file resources, and calls REST APIs.")
  Component(actTools, "Act Tools", "ActFunctionTools + ActSpecFunctionTools", "Loads Act details, starts Acts, and retrieves asynchronous results.")
  Component(guidanceTools, "Guidance Tools", "GuidanceFunctionTools", "Discovers and processes guidance-tagged files synchronously or asynchronously.")
  Component(contextTools, "Project Context Tools", "ProjectContextFunctionTools", "Stores and retrieves project-scoped variables shared by processing and episodes.")
}

Rel(user, cli, "Invokes", "CLI")
Rel(cli, guidanceProcessor, "Starts Guidance mode")
Rel(cli, actProcessor, "Starts Act mode")
Rel(cli, fileProcessor, "Configures scan")

Rel(guidanceProcessor, fileProcessor, "Uses scan lifecycle")
Rel(actProcessor, fileProcessor, "Uses scan lifecycle")
Rel(guidanceProcessor, aiProcessor, "Processes guidance with")
Rel(actProcessor, aiProcessor, "Executes episodes with")
Rel(actProcessor, episodes, "Selects and executes")
Rel(guidanceProcessor, javaReviewer, "Dispatches by extension")
Rel(guidanceProcessor, markdownReviewer, "Dispatches by extension")
Rel(guidanceProcessor, pumlReviewer, "Dispatches by extension")
Rel(guidanceProcessor, otherReviewers, "Dispatches by extension")

Rel(fileProcessor, projectFiles, "Traverses and filters")
Rel(fileProcessor, projectLayout, "Discovers layout")
Rel(guidanceProcessor, projectFiles, "Reads guidance-bearing files")
Rel(actProcessor, projectFiles, "Reads files and local TOML Acts")
Rel(actProcessor, remoteResources, "Loads remote Acts", "HTTP/HTTPS")

Rel(aiProcessor, projectFiles, "Resolves file inclusions", "file://")
Rel(aiProcessor, remoteResources, "Resolves referenced content", "HTTP/HTTPS")
Rel(aiProcessor, projectLayout, "Uses project context")
Rel(aiProcessor, processProvider, "Prompts and receives responses", "GenAI API")
Rel(actProcessor, contextTools, "Shares episode context")
Rel(aiProcessor, contextTools, "Initializes project context")

Rel(fileTools, projectFiles, "Reads and writes")
Rel(commandTools, projectFiles, "Runs within")
Rel(webTools, remoteResources, "Fetches and calls", "HTTP/HTTPS/REST")
Rel(webTools, projectFiles, "Reads file resources")
Rel(actTools, actProcessor, "Loads or starts")
Rel(guidanceTools, guidanceProcessor, "Supports")
Rel(contextTools, projectFiles, "Scopes context to project")

Rel(aiProcessor, fileTools, "Registers enabled tools")
Rel(aiProcessor, commandTools, "Registers enabled tools")
Rel(aiProcessor, controlTools, "Registers enabled tools")
Rel(aiProcessor, webTools, "Registers enabled tools")
Rel(aiProcessor, actTools, "Registers enabled tools")
Rel(aiProcessor, guidanceTools, "Registers enabled tools")
Rel(aiProcessor, contextTools, "Registers enabled tools")

SHOW_LEGEND()
@enduml
